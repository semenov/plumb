// The API's routes.

import api
import articles
import comments
import http
import profiles
import users

pub fn router(app: api.App) -> http.Router {
  var router = http.Router()
  router.use(http.log_requests())
  router.use(http.cors(["*"]))
  router.use(api.errors())

  router.post("/api/users", req => users.register(req, app))
  router.post("/api/users/login", req => users.login(req, app))
  router.get("/api/user", req => users.current(req, app))
  router.put("/api/user", req => users.update(req, app))

  router.get("/api/profiles/:username", req => profiles.get(req, app))
  router.post("/api/profiles/:username/follow", req => profiles.follow(req, app))
  router.delete("/api/profiles/:username/follow", req => profiles.unfollow(req, app))

  // before /api/articles/:slug: the first route that matches wins
  router.get("/api/articles/feed", req => articles.feed(req, app))
  router.get("/api/articles", req => articles.get_list(req, app))
  router.post("/api/articles", req => articles.create(req, app))
  router.get("/api/articles/:slug", req => articles.get(req, app))
  router.put("/api/articles/:slug", req => articles.update(req, app))
  router.delete("/api/articles/:slug", req => articles.delete(req, app))
  router.post("/api/articles/:slug/favorite", req => articles.favorite(req, app))
  router.delete("/api/articles/:slug/favorite", req => articles.unfavorite(req, app))

  router.get("/api/articles/:slug/comments", req => comments.list(req, app))
  router.post("/api/articles/:slug/comments", req => comments.add(req, app))
  router.delete("/api/articles/:slug/comments/:id", req => comments.delete(req, app))

  router.get("/api/tags", req => articles.tags_list(req, app))
  return router
}

// The API through the router, without a network: `plumb test tests.plumb`.
// The full suites (hurl, Postman) run against the server: tests/api-tests.sh.

import api
import db
import http
import json
import server
import schema

type Token {
  token: String
}

type TokenBody {
  user: Token
}

fn send(app: api.App, method: String, path: String, body: String, token: String) -> http.Response {
  var req = http.request(method, path)
  req.body = body.bytes()
  if not token.is_empty() {
    req.headers["authorization"] = "Token ${token}"
  }
  return server.router(app).handle(req)
}

fn register(app: api.App, name: String) -> String {
  let body = "{\"user\": {\"username\": \"${name}\", \"email\": \"${name}@example.com\", \"password\": \"password123\"}}"
  let res = send(app, method: "POST", path: "/api/users", body: body, token: "")
  if res.status != 201 {
    // `expect` only works in the test block itself
    throw Failure(message: "register ${name}: ${res.status} ${res.text()}")
  }
  return json.decode<TokenBody>(res.text()).user.token
}

test "register, then the token finds the user" {
  with conn = db.open(":memory:") {
    schema.create(conn)
    let app = api.App(conn: conn, secret: "test")
    let token = register(app, name: "ada")
    let res = send(app, method: "GET", path: "/api/user", body: "", token: token)
    expect res.status == 200
    expect (res.text()).contains("\"username\":\"ada\"")
  }
}

test "errors have the API's shape" {
  with conn = db.open(":memory:") {
    schema.create(conn)
    let app = api.App(conn: conn, secret: "test")
    let missing = send(app, method: "GET", path: "/api/user", body: "", token: "")
    expect missing.status == 401
    expect (missing.text()) == "{\"errors\":{\"token\":[\"is missing\"]}}"
    register(app, name: "ada")
    let again = "{\"user\": {\"username\": \"ada\", \"email\": \"other@example.com\", \"password\": \"password123\"}}"
    let taken = send(app, method: "POST", path: "/api/users", body: again, token: "")
    expect taken.status == 409
    expect (taken.text()) == "{\"errors\":{\"username\":[\"has already been taken\"]}}"
  }
}

test "the same title twice gives two slugs; the feed is not an article" {
  with conn = db.open(":memory:") {
    schema.create(conn)
    let app = api.App(conn: conn, secret: "test")
    let token = register(app, name: "ada")
    let article = "{\"article\": {\"title\": \"How to Train Your Dragon!\", \"description\": \"d\", \"body\": \"b\", \"tagList\": [\"z\", \"a\"]}}"
    let first = send(app, method: "POST", path: "/api/articles", body: article, token: token)
    let second = send(app, method: "POST", path: "/api/articles", body: article, token: token)
    expect first.status == 201
    expect (first.text()).contains("\"slug\":\"how-to-train-your-dragon\"")
    expect (first.text()).contains("\"tagList\":[\"a\",\"z\"]")
    expect not (second.text()).contains("\"slug\":\"how-to-train-your-dragon\"")
    let feed = send(app, method: "GET", path: "/api/articles/feed", body: "", token: token)
    expect (feed.text()) == "{\"articles\":[],\"articlesCount\":0}"
  }
}

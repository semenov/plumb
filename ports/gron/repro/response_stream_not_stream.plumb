// FIXED (res.body() is an io.Stream). Was: http.ResponseStream reads like an io.Stream (read, read_line, read_all)
// but is a different type with no shared interface, so code that reads
// "a file, standard input or a URL" can't take one parameter: gron passes
// a record of two closures (Input in main.plumb) instead.
import files
import http
import io

fn count_lines(s: io.Stream) -> Int {
  var n = 0
  while s.read_line() is some(_) {
    n += 1
  }
  return n
}

fn main() {
  with f = files.open("plumb.toml") {
    print("${count_lines(f)}")
  }
  with res = http.open(http.ClientRequest(url: "http://example.com")) {
    print("${count_lines(res)}")
  }
}

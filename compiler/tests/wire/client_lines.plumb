// A response body read as an io.Stream, like a file or standard input.
import http
import io
import process

fn count_lines(s: io.Stream) -> Int {
  var n = 0
  while s.read_line() is some(_) {
    n += 1
  }
  return n
}

fn main() {
  with res = http.open(http.ClientRequest(url: process.args()[0])) {
    print("${count_lines(res.body())} lines")
  }
}

fn count(xs: List<Int>) -> Int {
  return xs.length
}

fn work() -> Int {
  return 7
}

fn main() throws {
  var xs = [3, 1, 2]
  var name = " Ada "
  // allowed: a result may be left unused
  count(xs)
  xs.pop()
  try "x".to_int() catch err { 0 }
  // a new version of the receiver, dropped: the call changes nothing
  xs.sorted()
  name.trim()
  // computed and never used
  xs.length + 1
  // a task's result is still waited for
  spawn work()
  // `let _ =` isn't needed
  let _ = count(xs)
  print("${xs} ${name}")
}

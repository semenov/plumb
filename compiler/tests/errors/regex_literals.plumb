// A regex written as a literal is checked at compile time: what the runtime
// would refuse is an error at the literal (the .err file).
import regex

fn main() {
  regex.compile("(\\d+)-(\\d+)")
  regex.compile("<(.+?)>")
  regex.compile("(?:ab)+")
  regex.compile("\\bword\\b")
  regex.compile("(a|b")
  regex.compile("[\\S]")
  regex.compile("\\p{L}+")
  let text = "(?:x)"
  regex.compile(text)
}

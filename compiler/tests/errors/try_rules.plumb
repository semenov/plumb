fn load(path: String) -> Int {
  throw Failure(message: "no ${path}")
}

fn twice(f: fn(Int) -> Int) -> Int {
  return f(f(1))
}

// `throws` isn't needed
fn total() throws -> Int {
  return load("a") + load("b")
}

// the language calls `to_string` itself: it can't fail
type Price {
  cents: Int

  fn to_string(self) -> String {
    return "${load("x")}"
  }
}

fn main() {
  // `try` without `catch` is not needed
  let a = try load("x")
  // nothing here can fail
  let b = try (a + 1) catch err { 0 }
  // a failing lambda where one that can't fail is expected
  let c = twice(n => n + load("y"))
  print("${a} ${b} ${c} ${total()} ${Price(cents: 1)}")
}

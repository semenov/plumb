import db
import http
import json

type Note {
  id: Int
  text: String
}

type Input {
  text: String
  fail: Bool = false
}

fn count(conn: db.Connection) throws -> Int {
  let rows = try conn.query<Note>("select id, text from notes", [])
  return rows.length
}

fn add_two(req: http.Request, conn: db.Connection) throws -> http.Response {
  let input = try json.decode<Input>(req.text())
  let before = try count(conn)
  let _ = try conn.transaction(() => {
    try conn.execute("insert into notes (text, at) values (?, 0)", [input.text])
    try conn.execute("insert into notes (text, at) values (?, 0)", ["${input.text} (2)"])
    if input.fail {
      throw Failure(message: "asked to fail")
    }
    0
  }) catch err {
    return http.json(409, {"error": err.message(), "before": "${before}", "after": "${try count(conn)}"})
  }
  return http.json(201, {"before": "${before}", "after": "${try count(conn)}"})
}

fn main() throws {
  with conn = try db.open("notes") {
    var router = http.Router()
    router.post("/edge/two", req => try add_two(req, conn: conn))
    router.get("/edge/bad-sql", req => {
      let _ = try conn.query<Note>("select nope from nothing", [])
      http.text(200, "?")
    })
    router.get("/edge/panic", req => {
      let xs = [1, 2, 3]
      http.text(200, "${xs[(req.query("i") ?? "7").length + 5]}")
    })
    router.get("/edge/echo", req => http.json(200, {"q": req.query("q") ?? "", "agent": req.header("user-agent") ?? "", "method": req.method, "path": req.path}))
    router.get("/edge/denied", req => {
      with other = try db.open("secret") {
        let _ = try other.query<Note>("select 1 as id, 'x' as text", [])
      }
      http.text(200, "?")
    })
    router.get("/edge/fetch", req => {
      let res = try http.get(req.query("url") ?? "https://example.com/")
      http.text(res.status, res.text())
    })
    try http.serve(router, port: 8080)
  }
}

import db
import http
import json
import storage
import time

type Note {
  id: Int
  text: String
}

type Input {
  text: String
  fail: Bool = false
}

fn count(conn: db.Connection) throws -> Int {
  let rows = conn.query<Note>("select id, text from notes", [])
  return rows.length
}

fn add_two(req: http.Request, conn: db.Connection) throws -> http.Response {
  let input = json.decode<Input>(req.text())
  let before = count(conn)
  try conn.transaction(() => {
    conn.execute("insert into notes (text, at) values (?, 0)", [input.text])
    conn.execute("insert into notes (text, at) values (?, 0)", ["${input.text} (2)"])
    if input.fail {
      throw Failure(message: "asked to fail")
    }
    0
  }) catch err {
    return http.json(409, {"error": err.message(), "before": "${before}", "after": "${count(conn)}"})
  }
  return http.json(201, {"before": "${before}", "after": "${count(conn)}"})
}

fn main() throws {
  with conn = db.open("notes") {
    var router = http.Router()
    router.post("/edge/two", req => add_two(req, conn: conn))
    router.get("/edge/bad-sql", req => {
      conn.query<Note>("select nope from nothing", [])
      http.text(200, "?")
    })
    router.get("/edge/panic", req => {
      let xs = [1, 2, 3]
      http.text(200, "${xs[(req.query("i") ?? "7").length + 5]}")
    })
    router.post("/edge/files/*key", req => {
      let key = req.param("key") ?? ""
      storage.put(key, data: req.body, content_type: req.header("content-type") ?? "")
      let back = storage.get(key) ?? "".bytes()
      let listed = storage.list("").length
      http.json(201, {"url": storage.url(key, expires: time.minutes(5)), "size": "${back.length}", "listed": "${listed}", "upload": storage.upload_url(key, options: storage.Upload(max_bytes: 100)), "deleted": "${storage.delete(key)}"})
    })
    router.get("/edge/echo", req => http.json(200, {"q": req.query("q") ?? "", "agent": req.header("user-agent") ?? "", "method": req.method, "path": req.path}))
    router.get("/edge/denied", req => {
      with other = db.open("secret") {
        other.query<Note>("select 1 as id, 'x' as text", [])
      }
      http.text(200, "?")
    })
    router.get("/edge/fetch", req => {
      let res = http.get(req.query("url") ?? "https://example.com/")
      http.text(res.status, res.text())
    })
    http.serve(router, port: 8080)
  }
}

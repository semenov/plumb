import files
import path
import process
import env
import log
import random
import time

fn main() {
  with dir = files.temp_dir() {
    let file = path.join(dir.path, "notes.txt")
    files.write(file, "first\nsecond\n")
    files.append(file, "third\n")
    print(files.read(file))
    with f = files.open(file) {
      var n = 0
      while f.read_line() is some(line) {
        n += 1
        print("${n}: ${line}")
      }
    }
    with out = files.create(path.join(dir.path, "out.txt")) {
      out.write_text("written piece by piece")
    }
    files.make_dir(path.join(dir.path, "a/b/c"))
    print("${files.list(dir.path)}")
    print("${path.name(file)} in ${path.name(path.parent(file)).starts_with("program-")}, ext ${path.extension(file) ?? "-"}")
    let missing = try files.read(path.join(dir.path, "nope.txt")) catch err {
      print("error: ${err.message().contains("No such file")}")
      ""
    }
    print("missing = '${missing}'")
  }
  let r = process.run("echo", ["hello", "from echo"])
  print("status ${r.status}: ${r.stdout.trim()}")
  let bad = process.run("sh", ["-c", "echo oops >&2; exit 3"])
  print("status ${bad.status}: ${bad.stderr.trim()}")
  print("HOME set: ${env.get("HOME") != none}, NOPE: ${env.get("NO_SUCH_VARIABLE_X") ?? "none"}")
  let dice = random.between(1, 6)
  print("dice ok: ${dice >= 1 and dice <= 6}, token length ${random.token(16).length}")
  print("shuffled keeps items: ${random.shuffle([1, 2, 3]).sorted() == [1, 2, 3]}")
  let now = time.utc_now()
  print("year ok: ${now.year >= 2025}, iso length ${now.iso_millis().length}")
  print("${time.from_unix(0).iso()} ${time.from_unix(1767225600).date().iso()}")
  print("${path.stem("a/b/report.tar.gz")} ${path.clean("a/./b/../c")} ${path.clean("/x/../../y")} ${path.parts("/usr/local/bin")} ${path.is_absolute("rel/x")}")
  log.info("done")
}

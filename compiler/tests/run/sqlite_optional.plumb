// Optional values as parameters: none is NULL.

import db

type Row {
  name: String
  bio: String?
  age: Int?
}

fn main() {
  with conn = db.open(":memory:") {
    conn.execute("create table users (name text, bio text, age integer)", [])
    let bio: String? = none
    let age: Int? = 36
    conn.execute("insert into users (name, bio, age) values (?, ?, ?)", ["ada", bio, age])
    conn.execute("insert into users (name, bio, age) values (?, ?, ?)", ["bob", "hi", none])
    print("${conn.query<Row>("select * from users", [])}")
  }
}

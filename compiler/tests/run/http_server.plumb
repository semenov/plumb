import db
import http
import json
import log

type Note {
  id: Int
  title: String
  text: String
}

type NewNote {
  title: String
  text: String
}

// the state every request shares is in the database
fn open_notes() -> db.Connection {
  with conn = db.open(":memory:") {
    conn.execute("create table notes (id integer primary key, title text not null, text text not null)", [])
    return conn
  }
}

fn create(conn: db.Connection, req: http.Request) -> http.Response {
  let input = json.decode<NewNote>(req.text())
  let id = conn.insert("insert into notes (title, text) values (?, ?)", [input.title, input.text])
  return http.json(201, Note(id: id, title: input.title, text: input.text))
}

fn get(conn: db.Connection, req: http.Request) -> http.Response {
  let id = (req.param("id") ?? "").to_int()
  let found = conn.query<Note>("select id, title, text from notes where id = ?", [id])
  if found.first() is some(note) {
    return http.json(200, note)
  }
  return http.text(404, "no note ${id}")
}

fn crash(req: http.Request) -> http.Response {
  let items: List<Int> = []
  return http.text(200, "${items[5]}")
}

fn router(conn: db.Connection) -> http.Router {
  var r = http.Router()
  r.post("/notes", req => create(conn, req))
  r.get("/notes/:id", req => get(conn, req))
  r.get("/crash", crash)
  r.get("/hello", req => http.text(200, "hello ${req.query("name") ?? "you"}"))
  return r
}

test "a note that doesn't exist is a 404" {
  with conn = open_notes() {
    let res = router(conn).handle(http.request("GET", "/notes/9"))
    expect res.status == 404
  }
}

test "created notes can be read back" {
  with conn = open_notes() {
    let r = router(conn)
    var req = http.request("POST", "/notes")
    req.body = "{\"title\": \"a\", \"text\": \"b\"}".bytes()
    let created = r.handle(req)
    expect created.status == 201
    let res = r.handle(http.request("GET", "/notes/1"))
    expect res.text() == "{\"id\":1,\"title\":\"a\",\"text\":\"b\"}"
  }
}

fn main() {
  with conn = open_notes() {
    http.serve(router(conn), port: 18080)
  }
  log.info("bye")
}

test "files are served from their directory only" {
  var router = http.Router()
  router.files("/static", dir: "public")
  let ok = router.handle(http.request("GET", "/static/css/site.css"))
  expect ok.file == "public/css/site.css"
  let head = router.handle(http.request("HEAD", "/static/a.txt"))
  expect head.file == "public/a.txt"
  for bad in ["/static/../secret.txt", "/static/css/../../x", "/static/.env", "/static/.git/config"] {
    let res = router.handle(http.request("GET", bad))
    expect res.status == 404
    expect res.file == ""
  }
}

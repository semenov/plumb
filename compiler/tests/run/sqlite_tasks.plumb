// A connection shared by tasks: each transaction is the task's own.

import db
import time

type Count {
  n: Int
}

fn count(conn: db.Connection, who: String) throws -> Int {
  let rows = conn.query<Count>("select count(*) as n from t where who = ?", [who])
  return rows[0].n
}

fn slow_transaction(conn: db.Connection, who: String, fail: Bool) throws {
  conn.transaction(() => {
    conn.execute("insert into t (who) values (?)", [who])
    time.sleep(time.millis(30))
    if fail {
      throw Failure(message: "rolled back on purpose")
    }
  })
}

fn check(path: String) throws {
  with conn = db.open(path) {
    conn.execute("create table if not exists t (who text)", [])
    conn.execute("delete from t", [])

    // two transactions at once: the second waits for the first
    let a = spawn slow_transaction(conn, who: "a", fail: false)
    let b = spawn slow_transaction(conn, who: "b", fail: false)
    a.wait()
    b.wait()
    print("both committed: ${count(conn, "a") + count(conn, "b")}")

    // another task's insert doesn't join a transaction that rolls back
    let c = spawn slow_transaction(conn, who: "c", fail: true)
    time.sleep(time.millis(10))
    conn.execute("insert into t (who) values ('outside')", [])
    try c.wait() catch err {
      print("transaction: ${err}")
    }
    print("outside kept: ${count(conn, "outside")}, rolled back: ${count(conn, "c")}")

    // a transaction inside a transaction is a savepoint
    conn.transaction(() => {
      conn.execute("insert into t (who) values ('outer')", [])
      try conn.transaction(() => {
        conn.execute("insert into t (who) values ('inner')", [])
        throw Failure(message: "inner only")
      }) catch err {
        print("inner: ${err}")
      }
    })
    print("outer: ${count(conn, "outer")}, inner: ${count(conn, "inner")}")

    // many tasks, more than there are handles
    var tasks: List<Task<Int>> = []
    for i in 0..<40 {
      tasks.append(spawn conn.insert("insert into t (who) values ('many')", []))
    }
    for t in tasks {
      let _ = t.wait()
    }
    print("many: ${count(conn, "many")}")
  }
}

fn main() throws {
  check(":memory:")
  check("/tmp/plumb-sqlite-tasks.db")
}

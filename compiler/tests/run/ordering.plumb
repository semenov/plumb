// `<` and sorting for time types, and sorting records by a field.

import time

type User {
  id: Int
  name: String
}

fn main() {
  let a = time.millis(5)
  let b = time.seconds(1)
  print("${a < b} ${b < a} ${[b, a].sorted()}")
  let d1 = time.parse_iso("2026-09-29T12:00:00.5Z")
  let d2 = time.parse_iso("2026-09-29T12:00:00Z")
  print("${d2 < d1} ${[d1, d2].sorted()}")
  let us = [User(id: 3, name: "c"), User(id: 1, name: "a")]
  print("${us.sorted_by(u => u.id).map(u => u.name)}")
}

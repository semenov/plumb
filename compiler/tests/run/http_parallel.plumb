import http
import process
import time

// http.start and send_all: requests run at the same time, so four answers
// that each take half a second come in well under two seconds.
fn main() throws {
  var router = http.Router()
  router.get("/slow/:name", req => {
    time.sleep(time.millis(500))
    http.text(200, req.param("name") ?? "")
  })
  spawn http.serve(router, port: 18577)
  time.sleep(time.millis(300))
  let base = "http://127.0.0.1:18577/slow"
  let started = time.now()
  let a = http.start(http.ClientRequest(url: "${base}/a"))
  let b = http.start(http.ClientRequest(url: "${base}/b"))
  print("${b.wait().text()} ${a.wait().text()}")
  try a.wait() catch err {
    print("${err}")
    http.text(200, "")
  }
  let answers = http.send_all([http.ClientRequest(url: "${base}/c"), http.ClientRequest(url: "${base}/d"), http.ClientRequest(url: "${base}/e"), http.ClientRequest(url: "${base}/f")])
  print("${answers.map(r => r.text())}")
  http.start(http.ClientRequest(url: "${base}/never"))
  let took = time.now().since(started).seconds()
  print("at the same time: ${took < 1.8}")
  process.exit(0)
}

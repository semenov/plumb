// A failing call in a `throws` function sends its error up by itself;
// `try ... catch` handles it where it's written.

fn parse_all(texts: List<String>) throws -> List<Int> {
  return texts.map(t => t.to_int())
}

fn first_number(texts: List<String>) throws -> Int {
  let ns = parse_all(texts)
  return ns[0]
}

fn sum_or_zero(texts: List<String>) -> Int {
  // the lambda inside fails, and the catch around the call handles it
  return try texts.map(t => t.to_int()).sum() catch err { 0 }
}

fn main() throws {
  print("${first_number(["4", "5"])}")
  let n = try first_number(["x"]) catch err {
    print("caught: ${err}")
    -1
  }
  print("${n}")
  print("${sum_or_zero(["1", "2", "3"])} ${sum_or_zero(["1", "?"])}")
}

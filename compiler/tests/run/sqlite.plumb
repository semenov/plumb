import db

type UserId = Int

type User {
  id: UserId
  name: String
  age: Int
  active: Bool = true
  email: String?
}

fn add(conn: db.Connection, name: String, age: Int) throws -> Int {
  conn.execute("insert into users (name, age, active) values (?, ?, ?)", [name, age, age < 60])
  return conn.last_id()
}

fn main() throws {
  with conn = db.open(":memory:") {
    conn.execute("create table users (id integer primary key, name text not null, age integer, active integer, email text)", [])
    let ada = add(conn, name: "Ada", age: 36)
    let _ = add(conn, name: "Alan", age: 41)
    let _ = add(conn, name: "Grace", age: 85)
    print("ada is #${ada}")
    let adults = conn.query<User>("select id, name, age, active, email from users where age > ? order by age", [40])
    for u in adults {
      print("${u.id.value} ${u.name} ${u.age} active=${u.active} email=${u.email ?? "none"}")
    }
    let changed = conn.execute_counting("update users set email = ? where id = ?", ["ada@example.com", UserId(1)])
    print("changed ${changed}")
    let one = conn.query<User>("select * from users where id = ?", [UserId(1)])
    print("${one}")
    let _ = try conn.query<User>("select nme from users", []) catch err {
      print(err.message())
      []
    }
    let _ = try conn.transaction(() => {
      conn.execute("insert into users (name, age) values (?, ?)", ["Temp", 1])
      throw Failure(message: "changed my mind")
    }) catch err {
      print("rolled back: ${err.message()}")
      0
    }
    let new_id = conn.insert("insert into users (name, age) values (?, ?)", ["Inserted", 50])
    print("inserted: ${new_id == conn.last_id()}")
    // a bound `limit ?` makes SQLite prepare the statement again
    let newest = conn.query<User>("select id, name, age from users order by id desc limit ?", [2])
    print("newest: ${newest.length}")
    let count = conn.query<Count>("select count(*) as n from users", [])
    print("users: ${count[0].n}")
    let _ = try conn.query<User>("select id, name from users", []) catch err {
      print(err.message())
      []
    }
  }
}

type Count {
  n: Int
}

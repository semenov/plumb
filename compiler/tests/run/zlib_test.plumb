import zlib

fn main() throws {
  let data = "hello hello hello hello hello hello".bytes()
  let g = zlib.gzip(data)
  let d = zlib.deflate(data)
  print("${data.length} -> gzip ${g.length}, deflate ${d.length}")
  print(zlib.gunzip(g).text())
  print(zlib.inflate(d).text())
  print(zlib.inflate(g).text())
  let big = "abc".repeat(100000).bytes()
  print("${zlib.gunzip(zlib.gzip(big)).length} bytes back")
  let _ = try zlib.gunzip(data) catch err {
    print(err.message())
    return
  }
}

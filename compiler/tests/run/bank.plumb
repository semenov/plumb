type Account {
  id: Int
  balance: Int
}

type AccountNotFound implements Error {
  id: Int

  fn message(self) -> String {
    return "account ${self.id} does not exist"
  }
}

type InsufficientFunds implements Error {
  id: Int
  balance: Int
  amount: Int

  fn message(self) -> String {
    return "account ${self.id} has ${self.balance} but the transfer needs ${self.amount}"
  }
}

fn transfer(accounts: Map<Int, Account>, from: Int, to: Int, amount: Int) -> Map<Int, Account> {
  if amount <= 0 {
    throw Failure(message: "the amount must be positive")
  }
  let sender = accounts[from] ?? throw AccountNotFound(id: from)
  if accounts[to] is none {
    throw AccountNotFound(id: to)
  }
  if sender.balance < amount {
    throw InsufficientFunds(id: from, balance: sender.balance, amount: amount)
  }
  var result = accounts
  result[from].balance -= amount
  result[to].balance += amount
  return result
}

fn main() {
  var accounts: Map<Int, Account> = {}
  accounts[1] = Account(id: 1, balance: 100)
  accounts[2] = Account(id: 2, balance: 20)
  accounts = try transfer(accounts, from: 1, to: 2, amount: 50) catch err {
    if err is InsufficientFunds {
      print("not enough money: ${err.balance} < ${err.amount}")
    } else if err is AccountNotFound {
      print("no such account: ${err.id}")
    } else {
      print("transfer failed: ${err.message()}")
    }
    accounts
  }
  let again = try transfer(accounts, from: 2, to: 1, amount: 500) catch err {
    print(err.message())
    accounts
  }
  for entry in again {
    print("${entry.key}: ${entry.value.balance}")
  }
}

import io
import net

fn echo(conn: io.Stream) throws {
  conn.write_text("hello ${conn.peer().starts_with("127.0.0.1") or conn.peer().starts_with("::1")}\n")
  while conn.read_line() is some(line) {
    if line == "quit" {
      return
    }
    conn.write_text("${line.upper()}\n")
  }
}

fn main() throws {
  spawn udp_echo()
  net.serve(17000, conn => echo(conn))
}

fn udp_echo() throws {
  with sock = net.udp(17001) {
    while true {
      let d = sock.receive()
      sock.send_to("got ${d.data.text()}".bytes(), address: d.from)
    }
  }
}

// A UNIQUE or primary key violation is a sql.UniqueViolation.

import db
import sql

fn main() {
  with conn = db.open(":memory:") {
    conn.execute("create table users (id integer primary key, email text unique)", [])
    conn.insert("insert into users (email) values (?)", ["a@b.c"])
    try conn.insert("insert into users (email) values (?)", ["a@b.c"]) catch err {
      if err is sql.UniqueViolation {
        print("taken: ${err.column} (${err.message()})")
      }
      0
    }
    try conn.execute("insert into users (id, email) values (1, 'x')", []) catch err {
      print("${err is sql.UniqueViolation}")
    }
    try conn.execute("insert into nope values (1)", []) catch err {
      print("${err is sql.UniqueViolation}: ${err.message()}")
    }
  }
}

import time

fn slow() -> Int {
  time.sleep(time.seconds(10))
  return 1
}

fn quick() -> Int {
  return 42
}

fn failing() -> Int {
  throw Failure(message: "own error")
}

fn nested() -> Int {
  let a = spawn slow()
  let b = spawn slow()
  return a.wait() + b.wait()
}

fn main() {
  print("quick: ${time.timeout(time.seconds(1), () => quick())}")
  let start = time.now()
  try time.timeout(time.millis(100), () => slow()) catch err {
    print("slow: ${err.message()}, promptly: ${start.elapsed().millis() < 1000}")
    0
  }
  try time.timeout(time.seconds(1), () => failing()) catch err {
    print("own: ${err.message()}")
    0
  }
  let s2 = time.now()
  try time.timeout(time.millis(100), () => nested()) catch err {
    print("its tasks too: ${err is time.TimedOut}, promptly: ${s2.elapsed().millis() < 1000}")
    0
  }
}

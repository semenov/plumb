import template

type Item {
  name: String
  price: Decimal
  spicy: Bool = false
}

type Menu {
  shop: String
  items: List<Item>
  note: String
  html_note: String
}

type Customer {
  name: String
}

type Email {
  customer: Customer
  order_id: Int
  paid: Bool
}

fn main() throws {
  let views = template.load("views_fixture")
  print("${views.names()}")
  let menu = Menu(shop: "Tom's <Café>", items: [Item(name: "Soup", price: 4.50, spicy: true), Item(name: "Bread & butter", price: 1.20)], note: "<b>escaped</b>", html_note: "<b>raw</b>")
  print(views.render("menu", data: menu))
  print(views.render("email", data: Email(customer: Customer(name: "Ada"), order_id: 42, paid: false)))
  let empty = Menu(shop: "X", items: [], note: "", html_note: "")
  print(views.render("menu", data: empty))
  let t = template.compile("Hi {{nmae}}")
  try t.render(Customer(name: "Ada")) catch err {
    print(err.message())
    ""
  }
  try template.compile("{{#each items}} no end") catch err {
    print(err.message())
    t
  }
  let quick = template.compile_text("{{name}} & co")
  print(quick.render(Customer(name: "A<B")))
}

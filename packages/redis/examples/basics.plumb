import redis

fn main() throws {
  with db = redis.connect("redis://localhost:6379") {
    db.set("greeting", value: "hello")
    print(db.get("greeting") ?? "(none)")
    print("${db.get("missing") ?? "(none)"}")
    db.delete("visits")
    print("visits ${db.increment("visits")} ${db.increment_by("visits", amount: 10)}")
    db.set_for("temp", value: "x", seconds: 100)
    print("ttl ${db.time_to_live("temp") ?? -1}")
    print("lock ${db.set_new("lock", value: "me", seconds: 5)} ${db.set_new("lock", value: "me", seconds: 5)}")
    db.hash_set("user:1", field: "name", value: "Ada")
    db.hash_set("user:1", field: "plumb", value: "Plumb")
    print("${db.hash_get_all("user:1")}")
    db.delete("jobs")
    db.push("jobs", value: "a")
    db.push("jobs", value: "b")
    print("${db.range("jobs", from: 0, to: -1)} first ${db.pop_first("jobs") ?? ""}")
    let replies = db.pipeline([["SET", "p", "1"], ["INCR", "p"], ["GET", "p"]])
    print("pipeline ${replies.length}")
    try db.command(["LPUSH", "greeting", "x"]) catch err {
      print(err.message())
      return
    }
  }
}

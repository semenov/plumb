// Prints the next three messages on the "news" channel. Publish them from
// another terminal: redis-cli publish news "story 1"
import redis

fn main() throws {
  with sub = redis.subscribe("localhost:6379", channels: ["news"]) {
    for _ in 0..<3 {
      let m = sub.receive()
      print("${m.channel}: ${m.text}")
    }
  }
}

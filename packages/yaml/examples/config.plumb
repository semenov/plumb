import files
import json
import yaml

type Server {
  name: String
  weight: Int
}

type Config {
  name: String
  port: Int
  debug: Bool
  ratio: Float
  tags: List<String>
  admins: List<String>
  servers: List<Server>
  motd: String
  version: String
}

fn main() {
  let text = files.read("config.yaml")
  print(yaml.to_json(text))
  let c = yaml.decode<Config>(text)
  print("${c.name} ${c.port} ${c.debug} ${c.ratio} ${c.tags} ${c.admins} ${c.servers.map(s => s.name)} ${c.version}")
  let written = yaml.encode(c)
  print(written)
  let again = yaml.decode<Config>(written)
  print("round trip: ${json.encode(again) == json.encode(c)}")
}

import http

fn chat(ws: http.WebSocket) throws {
  ws.send_text("welcome")
  while ws.receive() is some(msg) {
    if msg.is_text {
      ws.send_text("echo: ${msg.text()}")
    } else {
      ws.send(msg.data)
    }
  }
}

fn main() throws {
  var router = http.Router()
  router.websocket("/chat", ws => chat(ws))
  router.get("/", req => http.text(200, "hi"))
  http.serve(router, port: 8116)
}

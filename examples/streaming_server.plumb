import http
import io
import time

fn ticks(req: http.Request) -> http.Response {
  return http.stream(200, content_type: "text/event-stream", writer: send_ticks)
}

fn send_ticks(out: io.Stream) {
  for i in 0..<3 {
    out.write_text("data: tick ${i}\n\n")
    time.sleep(time.millis(300))
  }
}

fn export(req: http.Request) -> http.Response {
  return http.stream(200, content_type: "text/csv", writer: out => write_rows(out))
}

fn write_rows(out: io.Stream) {
  out.write_text("id,name\n")
  for i in 0..<200000 {
    out.write_text("${i},item ${i}\n")
  }
}

fn broken(req: http.Request) -> http.Response {
  return http.stream(200, content_type: "text/plain", writer: out => fail_midway(out))
}

fn fail_midway(out: io.Stream) {
  out.write_text("partial\n")
  throw Failure(message: "the database went away")
}

fn main() {
  var router = http.Router()
  router.get("/ticks", ticks)
  router.get("/export", export)
  router.get("/broken", broken)
  http.serve(router, port: 8094)
}
